# ==============================================================================
# PULSE — AI Civic Sentiment Analytics Platform for RMC
# Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Never commit actual secret keys or production tokens to version control.
# ==============================================================================

# --- Django Application Settings ---
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-pulse-dev-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,*.trycloudflare.com

# --- Meta WhatsApp Business Cloud API Configuration ---
# Verify token entered into Meta App Dashboard under Webhook configuration
WHATSAPP_VERIFY_TOKEN=pulse_verify_token_2026

# Meta App Secret (found in App Dashboard -> Settings -> Basic) for HMAC-SHA256 signature validation
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Meta System User / Temporary Access Token (for outbound messages if enabled)
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here

# Meta WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# --- Server Host & Port Defaults ---
HOST=127.0.0.1
PORT=8000
