# ==============================================================================
# PULSE — Git Ignore Configuration
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.local
.env.*.local
*.env
!*.env.example

# --- Personal Data Minimization / Raw Municipal Datasets ---
# Excludes raw spreadsheet exports containing citizen names or phone numbers
*.xlsx
*.xls
*.csv
scratch/
tmp/
temp/
uploads/

# --- Local Databases & Runtime Storage ---
db.sqlite3
*.sqlite3
*.sqlite3-journal
*.db

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Byte-compiled / Cache files ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# --- macOS / OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs and Text Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs & Runtime Tunnels ---
*.log
.cloudflared/
